{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.4.3",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "rdm@rdm-download-manager",
      "strict_min_version": "140.0",
      "update_url": "https://github.com/vincentxjoubert-lang/rdm/releases/latest/download/updates.json",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "key": "",
  "permissions": ["downloads", "cookies", "webRequest", "contextMenus", "storage", "alarms", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://www.youtube-nocookie.com/*"],
      "js": ["youtube.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/watch*", "https://m.youtube.com/watch*"],
      "js": ["capture.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["relay.html", "relay.js"],
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"]
    }
  ],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "RDM", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } }
}
