<?xml version="1.0" encoding="utf-8"?>
<!-- RDM installer (WiX 3): per-user, in %LOCALAPPDATA%\Programs\RDM — no administrator prompt, so
     in-app updates install silently. A newer MSI replaces an older one (MajorUpgrade).
     Build: powershell -ExecutionPolicy Bypass -File packaging\windows\build-msi.ps1 -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Product Id="*" Name="RDM" Language="1033" Codepage="1252" Version="$(var.Version)"
           Manufacturer="RDM" UpgradeCode="7F3C2A91-5B64-4E0B-9D2A-6C8E1F4B3A77">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" InstallPrivileges="limited"
             Description="RDM - Rust Download Manager" Platform="x64" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of RDM is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="rdm.ico" SourceFile="$(var.Assets)\rdm.ico" />
    <Property Id="ARPPRODUCTICON" Value="rdm.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPHELPLINK" Value="$(var.Repository)" />
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsDir" Name="Programs">
          <Directory Id="INSTALLDIR" Name="RDM" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
      <Directory Id="DesktopFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="App" Guid="3C1E8F52-9A47-4D6B-B0E3-5F2A7C9D1E64" Win64="yes">
        <File Id="rdm.exe" Source="$(var.Exe)" />
        <RegistryValue Root="HKCU" Key="Software\RDM" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        <!-- Read by the next installer: this RDM knows how to quit on request (see QuitRdm). -->
        <RegistryValue Root="HKCU" Key="Software\RDM" Name="version" Type="string" Value="$(var.Version)" />
        <RemoveFolder Id="RemoveInstallDir" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
        <!-- Toast registration (HKCU, written by RDM): cleaned up on uninstall. -->
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\AppUserModelId\RDM.DownloadManager" Action="removeOnUninstall" />
      </Component>
      <Component Id="Shortcut" Guid="A4D2B7E9-1C58-4F3A-8E6D-0B9C2F7A5E13" Win64="yes">
        <Shortcut Id="StartMenu" Directory="ProgramMenuFolder" Name="RDM" Description="Download manager"
                  Target="[INSTALLDIR]rdm.exe" WorkingDirectory="INSTALLDIR" Icon="rdm.ico">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="RDM.DownloadManager" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\RDM" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="DesktopShortcut" Guid="49FD1533-B893-42AA-A0CF-7BBD8C878B2A" Win64="yes">
        <Shortcut Id="Desktop" Directory="DesktopFolder" Name="RDM" Description="Download manager"
                  Target="[INSTALLDIR]rdm.exe" WorkingDirectory="INSTALLDIR" Icon="rdm.ico">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="RDM.DownloadManager" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\RDM" Name="desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <!-- The browser extension's connector (native messaging host): RDM registers it with the
           browsers at every start (see native.rs); the registrations go with RDM. -->
      <Component Id="NativeHost" Guid="6DF21176-B17D-49D1-B459-10D853A12A63" Win64="yes">
        <RegistryValue Root="HKCU" Key="Software\RDM" Name="native" Type="integer" Value="1" KeyPath="yes" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Google\Chrome\NativeMessagingHosts\rdm.bridge" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Chromium\NativeMessagingHosts\rdm.bridge" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Microsoft\Edge\NativeMessagingHosts\rdm.bridge" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\BraveSoftware\Brave-Browser\NativeMessagingHosts\rdm.bridge" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Vivaldi\NativeMessagingHosts\rdm.bridge" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Mozilla\NativeMessagingHosts\rdm.bridge" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Waterfox\NativeMessagingHosts\rdm.bridge" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\LibreWolf\NativeMessagingHosts\rdm.bridge" Action="removeOnUninstall" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="RDM" Level="1">
      <ComponentRef Id="App" />
      <ComponentRef Id="Shortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="NativeHost" />
    </Feature>

    <!-- A running RDM must be gone before InstallValidate: otherwise Windows Installer reports
         success but leaves the old rdm.exe in place until the next reboot (the file is in use).
         First the installed rdm.exe is asked to quit (it closes cleanly, downloads saved: RDM 0.2.1
         and later; it waits until RDM is gone), then whatever is left (older versions do not know
         how to quit on request, and the browsers' connectors run the same rdm.exe) is ended,
         without a console window. -->
    <!-- Only an RDM installed by such an installer (0.2.1 and later) is asked: an older rdm.exe
         does not know the option and would start instead — the installation would wait forever. -->
    <Property Id="RDM_QUITS">
      <RegistrySearch Id="InstalledVersion" Root="HKCU" Key="Software\RDM" Name="version" Type="raw" />
    </Property>
    <CustomAction Id="QuitRdm" Directory="INSTALLDIR" ExeCommand="&quot;[INSTALLDIR]rdm.exe&quot; --quit" Return="ignore" Impersonate="yes" />
    <SetProperty Id="WixQuietExec64CmdLine" Value="&quot;[System64Folder]taskkill.exe&quot; /F /IM rdm.exe" Before="EndRdm" Sequence="execute" />
    <CustomAction Id="EndRdm" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="immediate" Return="ignore" />

    <!-- "Start with the system" is RDM's own setting (HKCU\…\Run\RDM, written by RDM): an
         uninstallation removes it — not an upgrade, which keeps the user's choice. -->
    <SetProperty Id="RemoveAutostart" Value="&quot;[System64Folder]reg.exe&quot; delete HKCU\Software\Microsoft\Windows\CurrentVersion\Run /v RDM /f" Before="RemoveAutostart" Sequence="execute" />
    <CustomAction Id="RemoveAutostart" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="ignore" Impersonate="yes" />

    <!-- Start RDM when the installation ends (also after an in-app update). -->
    <CustomAction Id="Launch" Directory="INSTALLDIR" ExeCommand="[INSTALLDIR]rdm.exe" Return="asyncNoWait" Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="QuitRdm" Before="EndRdm">RDM_QUITS AND (Installed OR WIX_UPGRADE_DETECTED)</Custom>
      <Custom Action="EndRdm" Before="InstallValidate">Installed OR WIX_UPGRADE_DETECTED</Custom>
      <Custom Action="RemoveAutostart" Before="RemoveRegistryValues">REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="Launch" After="InstallFinalize">NOT Installed OR WIX_UPGRADE_DETECTED</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
